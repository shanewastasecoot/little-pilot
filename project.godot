; Engine configuration file.
; Pinned engine version: Godot 4.7.2 stable (standard, not .NET).

config_version=5

[application]

config/name="Little Pilot"
config/description="A relaxing flying sandbox for young children."
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/core/game_settings.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

fly_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventKey,"device":-1,"physical_keycode":4194320)]
}
fly_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventKey,"device":-1,"physical_keycode":4194322)]
}
turn_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventKey,"device":-1,"physical_keycode":4194319)]
}
turn_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventKey,"device":-1,"physical_keycode":4194321)]
}
boost={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0), Object(InputEventJoypadButton,"device":-1,"button_index":0), Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventKey,"device":-1,"physical_keycode":32)]
}
slow={
"deadzone": 0.3,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":4194326)]
}
honk={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":1), Object(InputEventKey,"device":-1,"physical_keycode":72)]
}
camera={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":3), Object(InputEventKey,"device":-1,"physical_keycode":67)]
}
look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":74)]
}
look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":76)]
}
look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":73)]
}
look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":75)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":6), Object(InputEventKey,"device":-1,"physical_keycode":4194305)]
}
debug_overlay={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194334)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="aircraft"
3d_physics/layer_3="push_volumes"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
