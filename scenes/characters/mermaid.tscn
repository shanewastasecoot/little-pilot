[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/characters/mermaid.gd" id="1_merm"]

[sub_resource type="AnimationNodeAnimation" id="node_idle"]
animation = &"idle"

[sub_resource type="AnimationNodeAnimation" id="node_wave"]
animation = &"wave"

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_start"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_to_wave"]
xfade_time = 0.35

[sub_resource type="AnimationNodeStateMachineTransition" id="tr_to_idle"]
xfade_time = 0.6

[sub_resource type="AnimationNodeStateMachine" id="state_machine"]
states/idle/node = SubResource("node_idle")
states/idle/position = Vector2(340, 100)
states/wave/node = SubResource("node_wave")
states/wave/position = Vector2(560, 100)
transitions = ["Start", "idle", SubResource("tr_start"), "idle", "wave", SubResource("tr_to_wave"), "wave", "idle", SubResource("tr_to_idle")]

[node name="Mermaid" type="Node3D"]
script = ExtResource("1_merm")

[node name="Model" type="Node3D" parent="."]

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]

[node name="AnimationTree" type="AnimationTree" parent="."]
active = false
tree_root = SubResource("state_machine")
anim_player = NodePath("../AnimationPlayer")
