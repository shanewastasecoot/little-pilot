[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/core/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/world/test_map.tscn" id="2_map"]
[ext_resource type="PackedScene" path="res://scenes/aircraft/aircraft.tscn" id="3_aircraft"]
[ext_resource type="PackedScene" path="res://scenes/aircraft/chase_camera.tscn" id="4_cam"]
[ext_resource type="PackedScene" path="res://scenes/ui/debug_hud.tscn" id="5_hud"]
[ext_resource type="Script" path="res://scripts/collectibles/star_manager.gd" id="6_stars"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="7_hud"]
[ext_resource type="Script" path="res://scripts/ui/title_screen.gd" id="8_title"]
[ext_resource type="Script" path="res://scripts/ui/plane_select.gd" id="9_select"]
[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="10_pause"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Map" parent="." instance=ExtResource("2_map")]

[node name="Aircraft" parent="." instance=ExtResource("3_aircraft")]

[node name="ChaseCamera" parent="." node_paths=PackedStringArray("target") instance=ExtResource("4_cam")]
target = NodePath("../Aircraft")

[node name="StarManager" type="Node" parent="."]
script = ExtResource("6_stars")

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("7_hud")

[node name="TitleScreen" type="CanvasLayer" parent="."]
script = ExtResource("8_title")

[node name="PlaneSelect" type="CanvasLayer" parent="."]
script = ExtResource("9_select")

[node name="PauseMenu" type="CanvasLayer" parent="."]
script = ExtResource("10_pause")

[node name="DebugHud" parent="." node_paths=PackedStringArray("aircraft") instance=ExtResource("5_hud")]
aircraft = NodePath("../Aircraft")
