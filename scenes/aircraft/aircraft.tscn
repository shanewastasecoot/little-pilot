[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/aircraft/aircraft_controller.gd" id="1_ctrl"]
[ext_resource type="Resource" path="res://resources/aircraft/prop_plane.tres" id="2_stats"]
[ext_resource type="Script" path="res://scripts/aircraft/flight_input.gd" id="3_input"]
[ext_resource type="Script" path="res://scripts/aircraft/flight_safety.gd" id="4_safety"]
[ext_resource type="PackedScene" path="res://scenes/aircraft/models/prop_plane_model.tscn" id="5_model"]

[sub_resource type="SphereShape3D" id="body_shape"]
